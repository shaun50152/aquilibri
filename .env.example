# Data mode: fixtures (local in-memory) | mongodb
DATA_MODE=fixtures

# Demo session anchor (used when DATA_MODE=fixtures)
DEMO_SESSION_ID=demo-session-hackuta-2026

# Synthetic site telemetry fixture under fixtures/ (fallback when Tiger is off/empty).
# - sites.json — short 3-hour horizon for missing-coverage tests
# - sites_extended_synthetic.json — long synthetic horizon for runnable demos
SITE_PROFILES_FIXTURE=sites_extended_synthetic.json

# MongoDB Atlas (required when DATA_MODE=mongodb)
MONGODB_URI=
MONGODB_DATABASE=aquilibri

# Tiger Data / Postgres (preferred source for GET /api/sites + solver)
# Prefer discrete PG* vars (Tiger Cloud style). TIGERDATA_DATABASE_URL is optional fallback.
PGHOST=
PGDATABASE=tsdb
PGUSER=
PGPASSWORD=
PGPORT=5432
PGSSLMODE=require
TIGERDATA_DATABASE_URL=
USE_TIGER_SITE_PROFILES=true

# Gemini (required for POST /api/operator/chat; manual preview works without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
