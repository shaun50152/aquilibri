# Data mode: fixtures (local in-memory) | mongodb | hybrid (future)
DATA_MODE=fixtures

# Demo session anchor (used when DATA_MODE=fixtures)
DEMO_SESSION_ID=demo-session-hackuta-2026

# Synthetic site telemetry fixture under fixtures/ (GET /api/sites + optimizer).
# - sites.json — short 3-hour horizon for missing-coverage tests (default)
# - sites_extended_synthetic.json — 18-hour explicitly synthetic horizon for
#   runnable reallocation demos (6h + 12h jobs). Required for meaningful previews.
SITE_PROFILES_FIXTURE=sites_extended_synthetic.json

# MongoDB Atlas (not required in fixtures mode)
MONGODB_URI=
MONGODB_DATABASE=aquilibri

# Tiger Data / Postgres telemetry (not required in fixtures mode)
TIGERDATA_DATABASE_URL=

# Gemini API (not required for structured preview; NL-only is the next milestone)
GEMINI_API_KEY=
GEMINI_MODEL=
