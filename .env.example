# Master data toggle:
#   synthetic — local fixtures (offline demo / Wi-Fi fallback)
#   live      — MongoDB Atlas jobs + Tiger Data sites (blank slate when empty)
# Legacy aliases still accepted: fixtures→synthetic, mongodb→live
DATA_MODE=synthetic

# Demo session id (jobs/notifications scoped to this in live MongoDB)
DEMO_SESSION_ID=demo-session-hackuta-2026

# Synthetic site telemetry fixture under fixtures/ (used when DATA_MODE=synthetic).
# - sites.json — short 3-hour horizon for missing-coverage tests
# - sites_extended_synthetic.json — long synthetic horizon for runnable demos
SITE_PROFILES_FIXTURE=sites_extended_synthetic.json

# MongoDB Atlas (required when DATA_MODE=live)
MONGODB_URI=
MONGODB_DATABASE=aquilibri

# Tiger Data / Postgres (required source for GET /api/sites + solver when DATA_MODE=live).
# Prefer discrete PG* vars (Tiger Cloud style). TIGERDATA_DATABASE_URL is optional fallback.
# Seed with: python scripts/seed_tiger_sites.py
PGHOST=
PGDATABASE=tsdb
PGUSER=
PGPASSWORD=
PGPORT=5432
PGSSLMODE=require
TIGERDATA_DATABASE_URL=

# Gemini (required for POST /api/operator/chat; manual preview works without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
